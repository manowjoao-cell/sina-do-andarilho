rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ranking: todos leem; cada jogador só grava o próprio registro, com valores plausíveis.
    match /ranking/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nick is string
        && request.resource.data.nick.size() >= 3 && request.resource.data.nick.size() <= 16
        && request.resource.data.h is int && request.resource.data.h >= 0 && request.resource.data.h <= 2000;
    }

    // Ranking do Até o Amanhecer: todos leem; cada jogador grava só o próprio registro.
    match /ranking_noite/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nick is string
        && request.resource.data.nick.size() >= 3 && request.resource.data.nick.size() <= 16
        && request.resource.data.t is int && request.resource.data.t >= 0 && request.resource.data.t <= 3600
        && request.resource.data.k is int && request.resource.data.k >= 0;
    }

    // Nicks únicos: o primeiro a registrar fica com o nick.
    match /nicks/{nick} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Salvamento na nuvem: cada conta lê e grava só o próprio progresso.
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.data is string && request.resource.data.data.size() < 900000;
    }

    // Sugestões: qualquer jogador envia; ninguém lê pelo jogo (você lê no console do Firebase).
    match /sugestoes/{id} {
      allow create: if request.auth != null && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 1500;
      allow read, update, delete: if false;
    }
  }
}
